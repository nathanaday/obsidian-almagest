{
  "name": "atlas-obsidian-plugin",
  "version": "10.1.0",
  "private": true,
  "description": "The Obsidian plugin for Atlas.",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node esbuild.config.mjs test && node --test build-test/*.test.cjs",
    "test:obsidian": "npm run build && vitest run test/obsidian"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
